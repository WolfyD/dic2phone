<?xml version="1.0" encoding="utf-8"?>
<!-- The speech model is big and re-downloadable; the vault is useless without this phone's
     Keystore key, so neither goes into backups or device transfers. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="whisper/" />
        <exclude domain="file" path="vault/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="whisper/" />
        <exclude domain="file" path="vault/" />
    </device-transfer>
</data-extraction-rules>
